# Server only. Never copy these variables into a VITE_ variable or desktop bundle.
HANDWRITING_API_KEY=
HANDWRITING_DELETE_AFTER=3600
# Set only after written resale/redistribution permission has been obtained.
HANDWRITING_RESALE_APPROVED=false
NODI_HANDWRITING_ADAPTER=/absolute/path/to/verified-integrations.mjs
NODI_HANDWRITING_INSPECTOR=/absolute/path/to/nodi-document-inspector
NODI_HANDWRITING_DATABASE=/absolute/private/path/handwriting.sqlite
NODI_HANDWRITING_STORAGE=/absolute/private/path/handwriting-files
NODI_HANDWRITING_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
PORT=8787
